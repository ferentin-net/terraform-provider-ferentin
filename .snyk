# Snyk (https://snyk.io) policy file
version: v1.25.0
ignore:
  SNYK-GOLANG-GITHUBCOMVMIHAILENCOMSGPACKV5-15702238:
    - '*':
        reason: >-
          CVE-2026-2454 describes a DoS via malformed msgpack frames over
          websockets. This provider does not expose msgpack to untrusted input:
          the only importers in the build are terraform-plugin-go's tftypes,
          tfprotov5 and tfprotov6, which use msgpack to serialize Terraform
          plugin protocol RPC messages over a local gRPC channel between
          Terraform CLI and the provider process. There is no network-facing
          or websocket surface.
          Upstream (vmihailenco/msgpack) has had no commits since 2023-10-26 and
          Snyk's advisory explicitly states there is no fixed version, so an
          upgrade is not available. Re-checked 2026-09-27: v5.4.1 is still the
          latest release, and terraform-plugin-go v0.31.0 (latest) still depends
          on it. Re-evaluate when HashiCorp swaps the serializer or a maintained
          fork appears.
        expires: '2026-12-27T00:00:00.000Z'
        created: '2026-05-13T00:00:00.000Z'
patch: {}
